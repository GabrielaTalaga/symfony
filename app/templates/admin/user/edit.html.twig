{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_edit'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.user_edit'|trans }}</h1>

    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button class="btn btn-success mt-3">
        {{ 'action.save'|trans }}
    </button>
    {{ form_end(form) }}

    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary mt-3">
        {{ 'action.back'|trans }}
    </a>
{% endblock %}
