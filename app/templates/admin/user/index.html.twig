{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_management'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.users'|trans }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'label.email'|trans }}</th>
            <th>{{ 'label.roles'|trans }}</th>
            <th>{{ 'label.actions'|trans }}</th>



        </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.email }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>
                    <a href="{{ path('admin_user_view', {'id': user.id}) }}" class="btn btn-sm btn-info">
                        {{ 'action.view'|trans }}
                    </a>
                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning">
                        {{ 'action.edit'|trans }}
                    </a>










                    <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" style="display:inline-block;" onsubmit="return confirm('{{ 'message.confirm_delete_user'|trans }}');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button class="btn btn-sm btn-danger">
                            {{ 'action.delete'|trans }}
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">{{ 'message.no_users'|trans }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
