{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_details'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.user_details'|trans }}</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>{{ 'label.id'|trans }}</th>
            <td>{{ user.id }}</td>
        </tr>
        <tr>
            <th>{{ 'label.email'|trans }}</th>
            <td>{{ user.email }}</td>
        </tr>
        <tr>
            <th>{{ 'label.roles'|trans }}</th>
            <td>{{ user.roles|join(', ') }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-warning">
        {{ 'action.edit'|trans }}
    </a>
    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">
        {{ 'action.back'|trans }}
    </a>
{% endblock %}
