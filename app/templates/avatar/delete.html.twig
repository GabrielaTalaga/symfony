<form method="post" action="{{ path('avatar_delete', {'id': avatar.id}) }}" onsubmit="return confirm('{{ 'avatar.delete.confirm'|trans }}');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ avatar.id) }}">
    <button class="btn btn-danger" type="submit">{{ 'avatar.delete.button'|trans }}</button>
</form>