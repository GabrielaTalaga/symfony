{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.category_view'|trans({'%title%': category.title}) }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.category_view'|trans({'%title%': category.title}) }}</h1>

    <dl>
        <dt>{{ 'label.id'|trans }}</dt>
        <dd>{{ category.id }}</dd>

        <dt>{{ 'label.title'|trans }}</dt>
        <dd>{{ category.title }}</dd>

        <dt>{{ 'label.created_at'|trans }}</dt>
        <dd>{{ category.createdAt|date('Y-m-d H:i') }}</dd>

        <dt>{{ 'label.updated_at'|trans }}</dt>
        <dd>{{ category.updatedAt|date('Y-m-d H:i') }}</dd>
    </dl>

    <p>
        <a href="{{ path('category_index') }}">
            ← {{ 'action.back_to_list'|trans }}
        </a>
    </p>
{% endblock %}
