{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.record_view'|trans({'%id%': record.id}) }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.record_view'|trans({'%id%': record.id}) }}</h1>

    {% if record is defined and record|length %}
        <dl>
            <dt>{{ 'label.title'|trans }}</dt>
            <dd>{{ record.title }}</dd>

            <dt>{{ 'label.content'|trans }}</dt>
            <dd>{{ record.content }}</dd>

            <dt>{{ 'label.tags'|trans }}</dt>
            <dd>{{ record.tags|join(', ') }}</dd>
        </dl>

        <p>
            <a href="{{ url('task_index') }}">{{ 'action.back_to_list'|trans }}</a>
        </p>

        <p>
            {% if is_granted('EDIT', record) %}
                <a class="btn btn-outline-success" href="{{ url('task_edit', {id: record.id}) }}" title="{{ 'action.edit'|trans }}">
                    {{ 'action.edit'|trans }}
                </a>
            {% endif %}
            {% if is_granted('DELETE', record) %}
                <a class="btn btn-outline-danger" href="{{ url('task_delete', {id: record.id}) }}" title="{{ 'action.delete'|trans }}">
                    {{ 'action.delete'|trans }}
                </a>
            {% endif %}
        </p>

    {% else %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'danger',
            message: 'message.record_not_found'|trans
        } %}
    {% endif %}
{% endblock %}
