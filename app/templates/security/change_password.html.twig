{% extends 'base.html.twig' %}

{% block title %}{{ 'title.change_password'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.change_password'|trans }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.plainPassword.first, {
        label: 'label.new_password'|trans
    }) }}
    {{ form_row(form.plainPassword.second, {
        label: 'label.repeat_password'|trans
    }) }}

    <button class="btn btn-primary">{{ 'action.change_password'|trans }}</button>
    {{ form_end(form) }}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message|trans }}</div>
    {% endfor %}
{% endblock %}
