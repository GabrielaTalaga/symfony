{% extends 'base.html.twig' %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h1>Rejestracja</h1>

            {{ form_start(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.plainPassword.first) }}
            {{ form_row(form.plainPassword.second) }}

            <button type="submit" class="btn btn-primary w-100">Zarejestruj się</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
