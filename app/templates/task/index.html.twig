{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.task_list'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.task_list'|trans }}</h1>

    <a href="{{ path('task_create') }}" class="btn btn-primary mb-3">
        {{ 'action.create_task'|trans }}
    </a>

    {% if pagination is defined and pagination.items|length %}

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'task.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.created_at'|trans, 'task.createdAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.updated_at'|trans, 'task.updatedAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label.title'|trans, 'task.title') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'label_category'|trans, 'category.title') }}</th>
                <th>{{ 'label.tags'|trans }}</th>
                <th>{{ 'label.author'|trans }}</th>
                <th>{{ 'label.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for task in pagination.items %}
                <tr>
                    <td>{{ task.id }}</td>
                    <td>{{ task.createdAt|format_date('long') }}</td>
                    <td>{{ task.updatedAt|format_date('long') }}</td>
                    <td>{{ task.title }}</td>
                    <td>
                        <a class="btn btn-outline-primary"
                           href="{{ url('task_index', {'categoryId': task.category.id, 'statusId': task.status.value}) }}"
                           title="{{ task.category.title }}">
                            {{ task.category.title }}
                        </a>
                    </td>

                    <td>
                        {% if task.tags is defined and task.tags|length %}
                            {% for tag in task.tags %}
                                <a class="btn btn-outline-primary btn-sm mb-1"
                                   href="{{ url('task_index', {'tagId': tag.id, 'statusId': task.status.value}) }}"
                                   title="{{ tag.title }}">
                                    {{ tag.title }}
                                </a>
                            {% endfor %}
                        {% else %}
                            <em>{{ 'message.no_tags'|trans }}</em>
                        {% endif %}
                    </td>

                    <td>
                        {% if task.author is not null %}
                            {{ task.author.email }}
                        {% else %}
                            <em>(no author)</em>
                        {% endif %}
                    </td>


                    <td>
                        <a href="{{ path('task_view', {id: task.id}) }}" class="btn btn-sm btn-outline-primary" title="{{ 'action.view'|trans }}">
                            {{ 'action.view'|trans }}
                        </a>
                        <a href="{{ path('task_edit', {id: task.id}) }}" class="btn btn-sm btn-outline-secondary" title="{{ 'action.edit'|trans }}">
                            {{ 'action.edit'|trans }}
                        </a>

                        <form method="post"
                              action="{{ path('task_delete', {id: task.id}) }}"
                              style="display:inline"
                              onsubmit="return confirm('{{ 'message.confirm_delete'|trans }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                            <input type="hidden" name="_method" value="DELETE">
                            <button class="btn btn-sm btn-outline-danger" type="submit">
                                {{ 'action.delete'|trans }}
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        {% include 'default/_single_alert_message.html.twig' with {
            type: 'warning',
            message: 'message.empty_list'|trans
        } %}
    {% endif %}
{% endblock %}
